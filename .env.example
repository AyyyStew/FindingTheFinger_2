# App runtime
APP_HTTP_PORT=80
APP_HTTPS_PORT=443
APP_DOMAIN=findingthefinger.example.com
POSTGRES_DB=ftf
POSTGRES_USER=ftf
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://ftf:change-me@postgres:5432/ftf
CORS_ALLOWED_ORIGINS=https://findingthefinger.example.com
PRELOAD_EMBED_MODEL=false
ENABLE_SEMANTIC_SEARCH=true
RUN_DB_MIGRATIONS=true
BACKEND_INSTALL_EMBEDDINGS=true

# Release artifact URLs
VITE_STATIC_BASE_URL=https://static.findingthefinger.ayyystew.com/releases/2026-07-18

# Keep DB dumps and projection assets on the same public R2 hostname by default.
DB_RESTORE_URL=https://static.findingthefinger.ayyystew.com/db/releases/2026-07-18/ftf_20260716.sql.gz

# Optional Hugging Face cache location inside the backend container
HF_HOME=/root/.cache/huggingface

# Release upload config
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_ASSETS=finding-the-finger
R2_BUCKET_DB=finding-the-finger
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://static.findingthefinger.ayyystew.com

# Optional if DB dump is served from a different public bucket/origin.
# If unset, publish_release_bundle.sh falls back to R2_PUBLIC_BASE_URL.
R2_DB_PUBLIC_BASE_URL=

# Terraform auth and SSH bootstrap
HCLOUD_TOKEN=your-hetzner-cloud-api-token
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
HCLOUD_SSH_PUBLIC_KEY_PATH=/home/you/.ssh/id_ed25519.pub
HCLOUD_SSH_KEY_NAME=alex-laptop
